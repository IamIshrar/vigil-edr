            ".jse",
            ".vbs",
            ".vbe",
            ".hta",
            ".wsf",
            ".lnk",
            ".iso",
            ".img"
          ]
        },
        {
          "field": "file.path",
          "op": "contains_any",
          "value": [
            "\\downloads\\",
            "\\appdata\\local\\temp\\"
          ]
        }
      ]
    },
    "description": "A script, shortcut or disk image arrived in Downloads or Temp. These formats are favourites for phishing payloads.",
    "advice": "Check where it came from before anyone opens it."
  },
  {
    "id": "VIG-060",
    "title": "LOLBin connected to the internet",
    "severity": "medium",
    "mitre": {
      "tactic": "Command and Control",
      "technique": "T1105",
      "name": "Ingress Tool Transfer"
    },
    "category": "network",
    "action": "connect",
    "match": {
      "all": [
        {
          "field": "process.name",
          "op": "in",
          "value": [
